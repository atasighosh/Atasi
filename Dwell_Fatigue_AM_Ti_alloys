# Standardization module
def stand(df1,df2):
    x1=df1.values
    scalar=preprocessing.StandardScaler()
    scalar.fit(x1)
    x2=df2.values
    name2=df2.columns
    x_std=scalar.transform(x2)
    x_std=pd.DataFrame(x_std)
    x_std.columns=name2
    return(x_std)

